Screen {
    layout: vertical;
}

#app-header {
    height: 1;
    content-align: center middle;
}

#app-footer {
    height: 1;
}

#workspace {
    height: 1fr;
    min-height: 0;
}

#main-pane {
    width: 1fr;
    min-width: 0;
}

#chat {
    height: 1fr;
    border: none;
}

#input-container {
    height: auto;
    max-height: 20;
    min-height: 3;
}

#command-suggestions {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

#command-suggestions.hidden {
    display: none;
}

#input {
    height: auto;
    min-height: 3;
}

#input:disabled {
    opacity: 0.5;
}

#status-bar,
#typing-indicator {
    height: 1;
}

.panel {
    width: 100%;
}

.panel-title {
    text-style: bold;
}

RichLog {
    overflow-y: auto;
}

.spinner,
.pulse {
    text-style: bold;
}

DynamicSidebar {
    overflow: hidden;
}

DynamicSidebar .sidebar-panel {
    width: 100%;
}

DynamicSidebar .sidebar-panel.collapsed {
    height: auto !important;
}

DynamicSidebar .sidebar-panel.collapsed > Static {
    display: none;
}

DynamicSidebar .sidebar-toggle {
    text-style: italic;
}

DynamicSidebar .sidebar-title,
DynamicSidebar .metric-value {
    text-style: bold;
}

DynamicSidebar #sidebar-session {
    height: 6;
}

DynamicSidebar #sidebar-model {
    height: 7;
}

DynamicSidebar #sidebar-files {
    height: 5;
}

DynamicSidebar #sidebar-telemetry {
    height: 10;
}

DynamicSidebar #sidebar-commands {
    height: auto;
}

DynamicSidebar .status-indicator {
    width: 1;
    text-align: center;
}

NotificationManager {
    dock: top;
    width: 100%;
    height: auto;
    layers: above;
    padding: 0 1;
}

ToastNotification {
    width: auto;
    max-width: 60;
    height: auto;
    padding: 1 2;
    dock: top;
}

CommandPaletteScreen {
    align: center middle;
}

ProviderConnectionScreen,
ModelSelectionScreen,
HelpScreen {
    align: center middle;
}

#palette-title,
#palette-search,
#palette-results,
#palette-help {
    width: 86;
    max-width: 92%;
}

#palette-title {
    height: 3;
    padding: 1 2;
    text-style: bold;
}

#palette-search {
    height: 3;
}

#palette-results {
    height: 14;
}

#palette-help {
    height: 1;
    padding: 0 2;
}

#connect-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    padding: 1 2;
}

#connect-title,
#model-title,
#help-title {
    text-style: bold;
}

#connect-title,
#model-title {
    margin-bottom: 1;
}

#connect-help {
    margin-top: 1;
}

#connect-error {
    height: 1;
}

#connect-actions,
#model-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#connect-actions Button,
#model-actions Button,
#help-footer Button {
    margin-left: 1;
}

#model-dialog {
    width: 104;
    max-width: 95%;
    height: auto;
    padding: 1 2 2 2;
}

#model-search {
    margin-bottom: 1;
}

#model-select {
    height: 8;
}

#model-help {
    margin-top: 1;
    margin-bottom: 1;
}

#help-container {
    width: 80;
    max-width: 95%;
    height: 80%;
    padding: 1 2;
}

#help-header {
    height: 3;
    padding: 1 0;
}

#help-content {
    height: 1fr;
    layout: horizontal;
}

#help-categories {
    width: 30;
    padding-right: 1;
}

.category-button {
    width: 100%;
    height: 3;
    border: none;
    margin-bottom: 1;
    text-align: left;
}

#help-commands {
    width: 1fr;
    padding-left: 1;
}

#help-shortcuts {
    height: 8;
    padding: 1;
}

#help-footer {
    height: 2;
    padding: 0 1;
}
