#chat {
    padding: 0 1;
}

#input-container {
    max-height: 14;
    min-height: 2;
    padding: 0;
}

#command-suggestions {
    max-height: 5;
    margin-bottom: 0;
}

#input {
    min-height: 2;
    padding: 0 1;
}

#status-bar,
