Screen {
    background: #f6f8fa;
    color: #24292f;
}

#chat {
    background: #f6f8fa;
    scrollbar-color: #0969da;
    scrollbar-background: #d0d7de;
}

#input-container,
#command-suggestions,
#status-bar,
#app-footer,
DynamicSidebar .sidebar-panel,
ToastNotification,
#connect-dialog,
#model-dialog,
#help-container {
    background: #ffffff;
}

#app-header {
    background: #ddf4ff;
    color: #0969da;
}

#command-suggestions,
#input,
#provider-select,
#provider-api-key,
#provider-model,
#model-search,
#model-select,
DynamicSidebar .sidebar-panel {
    border: tall #d0d7de;
}

#connect-dialog,
#model-dialog,
#help-container {
    border: round #d0d7de;
}

#input,
#provider-select,
#provider-api-key,
#provider-model,
#model-search,
#model-select {
    background: #ffffff;
}

#input:focus,
#provider-select:focus,
#provider-api-key:focus,
#provider-model:focus,
#model-search:focus {
    border: solid #0969da;
    background: #ffffff;
}

#chat:focus,
#command-suggestions:focus,
#palette-results:focus,
#model-select:focus {
    border: solid #0969da;
}

#input-container {
    border-top: solid #d0d7de;
}

#status-bar,
#app-footer,
#typing-indicator,
#connect-help,
#connect-hints,
#model-help,
#model-hints,
#help-shortcuts,
#help-footer,
DynamicSidebar .metric,
DynamicSidebar .sidebar-toggle {
    color: #57606a;
}

#typing-indicator {
    background: #f6f8fa;
}

#help-header,
#help-shortcuts,
#help-footer {
    background: #f6f8fa;
}

#help-header,
#help-shortcuts {
    border-bottom: solid #d0d7de;
}

#help-footer {
    border-top: solid #d0d7de;
}

#help-categories {
    border-right: solid #d0d7de;
}

.category-button {
    background: #eef2f6;
    color: #24292f;
}

.category-button:focus {
    background: #d0d7de;
}

.category-button.active {
    background: #0969da;
    color: #ffffff;
}

.panel-title,
#connect-title,
#model-title,
#help-title,
DynamicSidebar .sidebar-title,
DynamicSidebar .metric-value,
.spinner,
.pulse {
    color: #0969da;
}

#connect-error {
    color: #cf222e;
}

#connect-actions Button,
#model-actions Button,
#help-footer Button {
    background: #eef2f6;
    color: #24292f;
    border: tall #d0d7de;
}

#connect-actions Button:focus,
#model-actions Button:focus,
#help-footer Button:focus {
    border: solid #0969da;
}

DynamicSidebar {
    background: #f6f8fa;
    border-left: solid #d0d7de;
}

DynamicSidebar .status-ready {
    color: #1a7f37;
}

DynamicSidebar .status-busy {
    color: #9a6700;
}

DynamicSidebar .status-error {
    color: #cf222e;
}

RichLog {
    scrollbar-color: #0969da;
    scrollbar-background: #d0d7de;
}

ToastNotification {
    border: round #0969da;
}

ToastNotification.toast-success {
    background: #dafbe1;
    border: round #1a7f37;
    color: #1a7f37;
}

ToastNotification.toast-error {
    background: #ffebe9;
    border: round #cf222e;
    color: #cf222e;
}

ToastNotification.toast-info {
    background: #ddf4ff;
    border: round #0969da;
    color: #0969da;
}

ToastNotification.toast-warning {
    background: #fff8c5;
    border: round #9a6700;
    color: #9a6700;
}

#palette-title,
#palette-search,
#palette-results,
#palette-help {
    background: #ffffff;
}

#palette-title {
    color: #0969da;
    border: round #d0d7de;
}

#palette-search,
#palette-results {
    border: round #d0d7de;
}

#palette-search:focus {
    border: round #0969da;
}

#palette-help {
    color: #57606a;
}
